# ==========================================
# CẤU HÌNH CƠ SỞ DỮ LIỆU SUPABASE
# ==========================================

# 1. DATABASE_URL: Lấy từ Supabase -> Project Settings -> Database -> Connection string -> URI (Mode: Transaction hoặc Session qua port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Dùng cho Prisma migrate/db push (Kết nối trực tiếp qua port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 3. Supabase API Keys (Tùy chọn - Dùng cho Supabase Storage lưu ảnh bia mộ sau này)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Khóa bí mật JWT xác thực Admin
JWT_SECRET="nghiatrangtrada_secret_key_2026_pleiku_bienho"

# URL chính thức
NEXT_PUBLIC_SITE_URL="https://nghiatrangtrada.vn"
